# ---------------------------------------------------------------------------
# Bridgeline Partners - variables d'environnement
# Copier ce fichier vers .env puis renseigner les valeurs reelles.
# Ne jamais committer .env.
# ---------------------------------------------------------------------------

# Base de donnees PostgreSQL (Prisma).
# Local via Docker : voir README, section "Base de donnees".
# Production : Vercel Postgres, Neon, Supabase, RDS...
DATABASE_URL="postgresql://bridgeline:bridgeline@localhost:5432/bridgeline?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# URL publique de l'application. En local : http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Secret de signature des JWT de session.
# Generer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---------------------------------------------------------------------------
# Email transactionnel (Resend)
# ---------------------------------------------------------------------------
# Cle API Resend : https://resend.com/api-keys
# Sans cette cle, les envois sont journalises dans la console au lieu d'etre
# expedies (utile en developpement, jamais acceptable en production).
RESEND_API_KEY=""

# Expediteur des emails. Le domaine doit etre verifie dans Resend.
EMAIL_FROM="Bridgeline Partners <no-reply@bridgeline.ch>"

# Boite interne qui recoit les formulaires de contact et les demandes d'acces.
CONTACT_INBOX="info@bridgeline.ch"
